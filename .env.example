# ==================== LLM大模型配置 ====================
# 支持的LLM提供商: openai, deepseek, aliyun, baidu
# 推荐国内用户使用: deepseek (速度快、稳定)
LLM_PROVIDER=deepseek

# DeepSeek配置 (国内推荐)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
# 全局默认模型：deepseek-v4-flash（2026-08-29 起默认 flash，apikey 成本考量；flash 对方案生成/匹配足够）。
# Agent 模式主路径已显式默认 flash，即使本变量设 pro，Agent 仍走 flash；pro 仅前端模型切换（model=deepseek-v4-pro）触发。
# 如需全局恢复 pro 质量：改此处为 deepseek-v4-pro 或改服务器 .env 后重启服务。
MATCH_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEMPERATURE=0.1
# DeepSeek V4 思考模式开关（enabled/disabled，默认 disabled）。
# 注意：2026-07-31 V4-Flash-0731 正式版起 thinking 默认开启，思考会显著拖慢响应且
# 使 temperature 等参数失效。本项目生成方案文本无需推理，保持 disabled；确需思考改 enabled。
DEEPSEEK_THINKING=disabled
# LLM 单次输出 token 上限（默认 8000；上限不是目标长度，调大不会变慢，只防长方案被截断）
LLM_MAX_TOKENS=8000

# 阿里云百炼配置 (国内推荐)
ALIYUN_API_KEY=your-aliyun-api-key-here
ALIYUN_MODEL_NAME=qwen-turbo
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_TEMPERATURE=0.1

# 百度文心配置 (国内推荐)
BAIDU_API_KEY=your-baidu-api-key-here
BAIDU_SECRET_KEY=your-baidu-secret-key-here
BAIDU_MODEL_NAME=ernie-bot
BAIDU_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1
BAIDU_TEMPERATURE=0.1

# ==================== 天气查询（和风天气） ====================
# 顶栏天气条。key 放服务端，免费版约 1000 次/天。
# 注册：https://console.qweather.com/ → 创建项目 → 凭据选 API KEY
# API_HOST 为控制台项目里的专属域名（形如 abcdef.qweatherapi.com），每个项目不同
QWEATHER_API_KEY=your-qweather-api-key-here
QWEATHER_API_HOST=your-project.qweatherapi.com
QWEATHER_TIMEOUT=5

# OpenAI配置 (需要VPN)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-3.5-turbo-16k
OPENAI_TEMPERATURE=0.1

# ==================== 向量数据库配置 ====================
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_PERSIST_DIRECTORY=./data/vector_db
VECTOR_SEARCH_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ==================== 向量模型配置 (国内镜像加速) ====================
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_LOCAL_PATH=./data/embedding_model
HF_ENDPOINT=https://hf-mirror.com

# ==================== 网络环境配置 ====================
# 离线模式: true/false (离线模式需要预先下载模型)
OFFLINE_MODE=false
# 请求超时时间(秒) - 单次LLM请求读取超时，超时即重试
REQUEST_TIMEOUT=60
# 最大重试次数
MAX_RETRIES=2
# 重试间隔(秒)
RETRY_INTERVAL=2
# 网络检测超时(秒)
DETECTION_TIMEOUT=5

# ==================== 检索增强 & 流式治理开关（ruoyi-ai 学习项）====================
# 生产默认已开启混合召回与SSE心跳。如需回退，设为 false 后重启服务即可。
# RAG 召回增强：向量召回 + 关键词全文召回 → RRF 融合 → 阈值过滤
ENABLE_HYBRID_RETRIEVAL=true
RAG_RRF_ALPHA=0.5
RAG_RRF_K=60
RAG_THRESHOLD=0.0
# SSE 流式连接治理：心跳保活 + 超时清理
SSE_HEARTBEAT_ENABLED=true
SSE_HEARTBEAT_INTERVAL=30
SSE_TIMEOUT=300

# ==================== 知识库配置 ====================
KNOWLEDGE_BASE_DIRECTORY=./data/sample_solutions

# ==================== 安全与认证（生产环境必须修改）====================
# JWT 签名密钥：必须使用随机强密码！留空或默认值会导致登录令牌可被伪造
JWT_SECRET_KEY=change-in-production-please-set-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=360

# 初始管理员密码：留空则不自动创建 admin；设置后会创建 admin，
# 若旧 admin 仍使用默认密码 admin123，则启动时自动轮换为该值。
ADMIN_INITIAL_PASSWORD=

# 调试接口开关：生产保持 false；true 时才注册 /api/debug/echo-headers
ENABLE_DEBUG_ENDPOINTS=false

# ==================== 邮件 / 密码找回（生产环境必须配置）====================
# 用于"忘记密码"发送重置邮件。SMTP_PASS 为邮箱授权码，切勿写死在代码中
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@163.com
SMTP_PASS=your-smtp-authorization-code
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=https://cloudsol.cn

# ==================== 数据库（一般无需修改）====================
DATABASE_URL=sqlite:///./data/users.db

# ==================== 联网检索（P1-2，可选，默认关闭）====================
# Agent 联网检索 provider：留空则关闭（Agent 仅基于本地知识库作答）；
# 设为 tavily 或 serper 后，还需在下方填对应 API Key。未配置 Key 时自动降级、不报错。
WEB_SEARCH_PROVIDER=
# Tavily：https://tavily.com （注册后获取 API Key，免费额度充足）
# Serper：https://serper.dev
WEB_SEARCH_API_KEY=
# 每会话联网检索次数上限（防滥用/防幻觉外链刷屏）
WEB_SEARCH_MAX_PER_SESSION=3

# ==================== P2 多智能体执行开关（默认开启，可关闭回退旧行为）====================
# AGENT_TWO_PHASE=1：真·两阶段执行（plan 驱动工具调用顺序）；=0 回退旧 ReAct 自由循环。
# AGENT_MULTI_AGENT=1：三角色 Orchestrator-Workers（分析师→架构师→校验官）；=0 退化为单角色两阶段。
# 任一异常会自动降级到已验证的旧路径（稳定性铁律），生产环境建议保持默认。
AGENT_TWO_PHASE=1
AGENT_MULTI_AGENT=1

# ==================== P3 推理可靠性开关（默认开启，可关闭回退旧行为）====================
# AGENT_SELF_CHECK=1：交付前过「自检 Gate」（critic LLM 按 5 维 rubric 验收，不过则二次合成）。
# SELF_CHECK_PASS=70：critic 评分阈值（0-100），低于此值视为不通过、触发二次合成。
# 默认 70：critic 按「维度覆盖」而非「篇幅」评分，完整方案应达 80-95；仅明显缺维度才不过。
# SELF_CHECK_MAX_ITERS=2：最多二次合成次数（不含首次），达上限仍不过则放行并附 quality_warn。
# AGENT_REFLEXION_REPLAN=1：反思时做「真重规划」（读失败步→planner 产 plan_v2→重跑失败步），替代 P1-3 软重试。
# REFLEXION_MAX_REPLANS=2：最多重规划次数。
# AGENT_PARALLEL_TOOLS=1：同 plan 步内只读工具（search_kb/search_competitor/web_search）经 asyncio.gather 并发。
# MAX_PARALLEL=3：并发工具上限。
# 任一异常会自动跳过（自检/重规划/并行永不阻断用户），生产环境建议保持默认。
AGENT_SELF_CHECK=1
SELF_CHECK_PASS=70
SELF_CHECK_MAX_ITERS=2
AGENT_REFLEXION_REPLAN=1
REFLEXION_MAX_REPLANS=2
AGENT_PARALLEL_TOOLS=1
MAX_PARALLEL=3

# ==================== P2-3 MCP 远程工具客户端（默认关闭） ====================
# AGENT_MCP_CLIENT=1：首次 Agent 运行时按 MCP_SERVERS 连接外部 stdio MCP Server，
# 把远端工具注册进本地 ToolRegistry；=0（默认）不拉起任何子进程、零副作用，失败自动跳过。
AGENT_MCP_CLIENT=0
# MCP_SERVERS：JSON 数组，每项 {"command":[...], "label":"命名空间"}。
# 例：'[{"command":["python","-m","app.agent.mcp_server"],"label":"self"}]'
# label 仅允许 [A-Za-z0-9_-]，用于工具名前缀 mcp__<label>__<tool>。
MCP_SERVERS=
# 自带成本测算 Server（P0）示例：启用后 Agent 可调用 mcp__cost__cost_calc / mcp__cost__cost_reference_list
# 需同时设 AGENT_MCP_CLIENT=1 才生效；默认关闭、失败自动降级。
# MCP_SERVERS=[{"command":["python","-m","app.agent.mcp_server_cost_calc"],"label":"cost"}]

# ==================== P1 飞书/钉钉群机器人通知（默认关闭） ====================
# 群自定义机器人 webhook + 加签 secret；留空则该平台不推送（两个都空则整体零副作用）。
# 飞书 webhook：https://open.feishu.cn/open-apis/bot/v2/hook/xxxx ；secret=安全设置里的「签名校验」密钥。
# 钉钉 webhook：https://oapi.dingtalk.com/robot/send?access_token=xxxx ；secret=「加签」密钥。
# 触发：经典方案匹配完成 / Agent 生成成功；内容=需求+行业+cloudsol 链接。失败自动忽略。
FEISHU_WEBHOOK=
FEISHU_SECRET=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ==================== VECTOR_DB_PROVIDER=gaussdb 华为云 GaussDB 扩展点（默认 chroma 无需配置） ====================
# 启用 gaussdb 还需在 requirements.txt 增加 psycopg2-binary；GaussDBVectorDB 为结构化扩展点，
# 凭据缺失/驱动未装时抛 VectorDBConfigError（可操作指引），不阻断默认 chroma 模式。
GAUSSDB_HOST=
GAUSSDB_PORT=
GAUSSDB_USER=
GAUSSDB_PASSWORD=
GAUSSDB_DATABASE=
GAUSSDB_EMBEDDING_TABLE=huawei_solutions
