# ==================== LLM大模型配置 ====================
# 支持的LLM提供商: openai, deepseek, aliyun, baidu
# 推荐国内用户使用: deepseek (速度快、稳定)
LLM_PROVIDER=deepseek

# DeepSeek配置 (国内推荐)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL_NAME=deepseek-v4-pro
# 匹配生成专用模型（标准/向导模式）。Agent 模式仍用上面的 DEEPSEEK_MODEL_NAME(pro)。
# 标准/向导模式对延迟敏感，默认用 flash 显著降低墙钟并规避 60s 超时重试。
# 如需恢复 pro 质量，改此处为 deepseek-v4-pro 或改服务器 .env 后重启服务。
MATCH_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEMPERATURE=0.1

# 阿里云百炼配置 (国内推荐)
ALIYUN_API_KEY=your-aliyun-api-key-here
ALIYUN_MODEL_NAME=qwen-turbo
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_TEMPERATURE=0.1

# 百度文心配置 (国内推荐)
BAIDU_API_KEY=your-baidu-api-key-here
BAIDU_SECRET_KEY=your-baidu-secret-key-here
BAIDU_MODEL_NAME=ernie-bot
BAIDU_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1
BAIDU_TEMPERATURE=0.1

# OpenAI配置 (需要VPN)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-3.5-turbo-16k
OPENAI_TEMPERATURE=0.1

# ==================== 向量数据库配置 ====================
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_PERSIST_DIRECTORY=./data/vector_db
VECTOR_SEARCH_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ==================== 向量模型配置 (国内镜像加速) ====================
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_LOCAL_PATH=./data/embedding_model
HF_ENDPOINT=https://hf-mirror.com

# ==================== 网络环境配置 ====================
# 离线模式: true/false (离线模式需要预先下载模型)
OFFLINE_MODE=false
# 请求超时时间(秒) - 单次LLM请求读取超时，超时即重试
REQUEST_TIMEOUT=60
# 最大重试次数
MAX_RETRIES=2
# 重试间隔(秒)
RETRY_INTERVAL=2
# 网络检测超时(秒)
DETECTION_TIMEOUT=5

# ==================== 检索增强 & 流式治理开关（ruoyi-ai 学习项）====================
# 生产默认已开启混合召回与SSE心跳。如需回退，设为 false 后重启服务即可。
# RAG 召回增强：向量召回 + 关键词全文召回 → RRF 融合 → 阈值过滤
ENABLE_HYBRID_RETRIEVAL=true
RAG_RRF_ALPHA=0.5
RAG_RRF_K=60
RAG_THRESHOLD=0.0
# SSE 流式连接治理：心跳保活 + 超时清理
SSE_HEARTBEAT_ENABLED=true
SSE_HEARTBEAT_INTERVAL=30
SSE_TIMEOUT=300

# ==================== 知识库配置 ====================
KNOWLEDGE_BASE_DIRECTORY=./data/sample_solutions

# ==================== 安全与认证（生产环境必须修改）====================
# JWT 签名密钥：必须使用随机强密码！留空或默认值会导致登录令牌可被伪造
JWT_SECRET_KEY=change-in-production-please-set-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=360

# 初始管理员密码：留空则不自动创建 admin；设置后会创建 admin，
# 若旧 admin 仍使用默认密码 admin123，则启动时自动轮换为该值。
ADMIN_INITIAL_PASSWORD=

# 调试接口开关：生产保持 false；true 时才注册 /api/debug/echo-headers
ENABLE_DEBUG_ENDPOINTS=false

# ==================== 邮件 / 密码找回（生产环境必须配置）====================
# 用于"忘记密码"发送重置邮件。SMTP_PASS 为邮箱授权码，切勿写死在代码中
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@163.com
SMTP_PASS=your-smtp-authorization-code
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=https://cloudsol.cn

# ==================== 数据库（一般无需修改）====================
DATABASE_URL=sqlite:///./data/users.db
